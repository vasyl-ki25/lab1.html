<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Petal — Get your help from our product</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
/* ========================
   ЗМІННІ
======================== */
:root {
  --red:      #e53935;
  --red-dark: #c62828;
  --dark:     #111111;
  --dark2:    #1c1c1e;
  --gray-bg:  #f6f6f4;
  --gray-bd:  #e4e4e4;
  --gray-t:   #888888;
  --blue:     #1565c0;
  --blue-lt:  #e3eeff;
  --green:    #2e7d32;
  --white:    #ffffff;
  --text:     #1a1a1a;
  --font:     'DM Sans', sans-serif;
  --display:  'DM Serif Display', serif;
  --r-sm: 8px;
  --r-md: 16px;
  --r-lg: 24px;
  --r-xl: 32px;
  --sh-sm: 0 2px 8px rgba(0,0,0,.06);
  --sh-md: 0 8px 32px rgba(0,0,0,.10);
  --sh-lg: 0 24px 64px rgba(0,0,0,.13);
  --sh-red: 0 8px 28px rgba(229,57,53,.30);
}

/* ========================
   RESET
======================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: var(--font); color: var(--text); background: var(--white); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
a { text-decoration: none; color: inherit; }
ul { list-style: none; }

/* ========================
   LAYOUT
======================== */
.wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 28px;
}

/* ========================
   КНОПКИ
======================== */
.btn-red {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--red);
  color: #fff;
  font-family: var(--font);
  font-size: 15px;
  font-weight: 600;
  padding: 12px 26px;
  border-radius: 50px;
  border: none;
  cursor: pointer;
  transition: background .22s, transform .18s, box-shadow .22s;
}
.btn-red:hover { background: var(--red-dark); transform: translateY(-2px); box-shadow: var(--sh-red); }
.btn-red.lg   { padding: 15px 34px; font-size: 16px; }

.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 2px solid var(--gray-bd);
  color: var(--text);
  font-family: var(--font);
  font-size: 15px;
  font-weight: 600;
  padding: 13px 26px;
  border-radius: 50px;
  background: transparent;
  cursor: pointer;
  transition: border-color .22s, color .22s, transform .18s;
}
.btn-outline:hover { border-color: var(--red); color: var(--red); transform: translateY(-2px); }

.btn-ghost {
  display: inline-flex;
  align-items: center;
  font-size: 15px;
  font-weight: 500;
  color: var(--gray-t);
  padding: 9px 18px;
  border-radius: 50px;
  border: none;
  background: transparent;
  cursor: pointer;
  transition: background .2s, color .2s;
}
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }

/* ========================
   NAVBAR
======================== */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,.9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--gray-bd);
  transition: box-shadow .3s;
  /* потрібно для absolute-меню на мобільних */
  isolation: isolate;
}
.nav.scrolled { box-shadow: var(--sh-md); }
.nav-inner {
  display: flex;
  align-items: center;
  height: 66px;
  gap: 8px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--display);
  font-size: 21px;
  color: var(--dark);
  white-space: nowrap;
  margin-right: 16px;
}
.logo-dot {
  width: 8px;
  height: 8px;
  background: var(--red);
  border-radius: 50%;
  flex-shrink: 0;
}
.nav-links {
  display: flex;
  gap: 2px;
}
.nav-links a {
  font-size: 14px;
  font-weight: 500;
  color: var(--gray-t);
  padding: 7px 14px;
  border-radius: 50px;
  transition: color .2s, background .2s;
}
.nav-links a:hover { color: var(--text); background: var(--gray-bg); }
.nav-actions { display: flex; align-items: center; gap: 6px; margin-left: auto; }
.burger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  margin-left: auto;
}
.burger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--dark);
  border-radius: 2px;
  transition: transform .28s, opacity .2s;
}

/* ========================
   HERO
======================== */
.hero {
  padding: 84px 0 72px;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -160px;
  right: -240px;
  width: 680px;
  height: 680px;
  background: radial-gradient(circle, rgba(229,57,53,.07) 0%, transparent 70%);
  pointer-events: none;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 72px;
}
.hero-text h1 {
  font-family: var(--display);
  font-size: clamp(38px, 5vw, 64px);
  font-weight: 400;
  line-height: 1.08;
  color: var(--dark);
  margin-bottom: 22px;
}
.hero-text h1 .hl { color: var(--red); font-style: italic; }
.hero-sub {
  font-size: 17px;
  color: var(--gray-t);
  line-height: 1.7;
  max-width: 410px;
  margin-bottom: 36px;
}
.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }

/* Дашборд-картки */
.hero-visual {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.dash-card {
  flex: 1;
  background: var(--white);
  border: 1px solid var(--gray-bd);
  border-radius: var(--r-md);
  padding: 18px;
  box-shadow: var(--sh-md);
  transition: transform .3s, box-shadow .3s;
}
.dash-card:hover { transform: translateY(-5px); box-shadow: var(--sh-lg); }
.dash-card.dark {
  background: var(--dark);
  border-color: transparent;
  color: #fff;
  flex: 1.25;
  margin-top: 24px;
}
.dc-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .09em;
  color: var(--gray-t);
  margin-bottom: 5px;
  font-weight: 500;
}
.dash-card.dark .dc-label { color: rgba(255,255,255,.45); }
.dc-value {
  font-family: var(--display);
  font-size: 21px;
  color: var(--dark);
  margin-bottom: 8px;
  line-height: 1;
}
.dash-card.dark .dc-value { color: #fff; }
.dc-value.red { color: var(--red) !important; }
.dc-tags { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
.tag {
  font-size: 10px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 50px;
}
.tag-g { background: rgba(46,125,50,.18); color: #4caf50; }
.tag-w { background: rgba(255,255,255,.1); color: rgba(255,255,255,.55); }
.dc-canvas { display: block; width: 100%; }

/* ========================
   STATS
======================== */
.stats { padding: 96px 0; background: var(--gray-bg); }
.section-h {
  font-family: var(--display);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 400;
  color: var(--dark);
  text-align: center;
  margin-bottom: 48px;
  line-height: 1.2;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.stat-card {
  background: var(--white);
  border-radius: var(--r-md);
  padding: 32px 20px;
  text-align: center;
  box-shadow: var(--sh-sm);
  transition: transform .28s, box-shadow .28s;
}
.stat-card:hover { transform: translateY(-5px); box-shadow: var(--sh-md); }
.stat-icon {
  font-size: 22px;
  font-family: 'Courier New', monospace;
  color: var(--gray-t);
  margin-bottom: 14px;
}
.stat-num {
  font-family: var(--display);
  font-size: 42px;
  font-weight: 700;
  color: var(--dark);
  line-height: 1;
  margin-bottom: 10px;
}
.stat-desc { font-size: 14px; color: var(--gray-t); line-height: 1.5; }

/* ========================
   PLANS
======================== */
.plans { padding: 96px 0; background: var(--white); }
.plans-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  align-items: start;
}
.plan-card {
  border: 1.5px solid var(--gray-bd);
  border-radius: var(--r-lg);
  padding: 32px;
  background: var(--white);
  position: relative;
  transition: transform .28s, box-shadow .28s, border-color .28s;
}
.plan-card:hover { transform: translateY(-6px); box-shadow: var(--sh-lg); border-color: #bbb; }
.plan-card.featured {
  border-color: var(--red);
  box-shadow: 0 12px 48px rgba(229,57,53,.12);
}
.plan-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 50px;
  margin-bottom: 14px;
}
.badge-blue { background: var(--blue-lt); color: var(--blue); }
.badge-red  { background: rgba(229,57,53,.1); color: var(--red); }
.badge-dark { background: var(--gray-bg); color: var(--dark); }
.plan-pop {
  position: absolute;
  top: 22px;
  right: 22px;
  background: var(--red);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 50px;
}
.plan-name {
  font-family: var(--display);
  font-size: 22px;
  font-weight: 400;
  color: var(--dark);
  margin-bottom: 8px;
}
.plan-desc { font-size: 14px; color: var(--gray-t); line-height: 1.65; margin-bottom: 24px; }
.plan-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
.plan-list li { display: flex; align-items: center; gap: 10px; font-size: 14px; }
.chk {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
  flex-shrink: 0;
}
.chk-blue { background: var(--blue-lt); color: var(--blue); }
.chk-red  { background: rgba(229,57,53,.1); color: var(--red); }
.chk-dark { background: var(--gray-bg); color: var(--dark); }
.chk-gray { background: var(--gray-bg); color: var(--gray-t); }
.plan-btn {
  display: block;
  text-align: center;
  padding: 12px 0;
  border-radius: 50px;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  border: none;
  cursor: pointer;
  transition: opacity .2s, transform .18s;
}
.plan-btn:hover { opacity: .85; transform: translateY(-1px); }
.plan-btn.blue { background: var(--blue); }
.plan-btn.red  { background: var(--red);  }
.plan-btn.dark { background: var(--dark); }

/* ========================
   FEATURES
======================== */
.features { padding: 96px 0; background: var(--gray-bg); }
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
/* Картка з кредитною карткою */
.feat-card {
  background: var(--white);
  border-radius: var(--r-xl);
  padding: 32px;
  box-shadow: var(--sh-md);
}
.feat-card-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--gray-t);
  font-weight: 500;
  margin-bottom: 14px;
}
.credit-card {
  background: var(--dark);
  border-radius: var(--r-md);
  padding: 24px;
  color: #fff;
  min-height: 148px;
  position: relative;
  overflow: hidden;
  margin-bottom: 24px;
  box-shadow: var(--sh-lg);
}
.credit-card::before {
  content: '';
  position: absolute;
  top: -50px; right: -50px;
  width: 180px; height: 180px;
  background: rgba(255,255,255,.04);
  border-radius: 50%;
}
.credit-card::after {
  content: '';
  position: absolute;
  bottom: -70px; right: -30px;
  width: 220px; height: 220px;
  background: rgba(229,57,53,.1);
  border-radius: 50%;
}
.cc-chip {
  width: 36px;
  height: 28px;
  background: linear-gradient(135deg, #ffd700, #f59f00);
  border-radius: 5px;
  margin-bottom: 20px;
  position: relative;
  z-index: 1;
}
.cc-num {
  font-family: 'Courier New', monospace;
  font-size: 15px;
  letter-spacing: .14em;
  margin-bottom: 18px;
  position: relative;
  z-index: 1;
}
.cc-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
  z-index: 1;
}
.cc-name  { font-size: 12px; letter-spacing: .1em; opacity: .75; }
.cc-brand { font-family: var(--display); font-size: 18px; }
.feat-stats { display: flex; flex-direction: column; gap: 0; }
.fs-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 13px 0;
  border-bottom: 1px solid var(--gray-bg);
}
.fs-row:last-child { border-bottom: none; }
.fs-label { font-size: 14px; color: var(--gray-t); }
.fs-val   { font-size: 15px; font-weight: 600; color: var(--dark); }
.fs-val.green { color: var(--green); }
.fs-val.blue  { color: var(--blue);  }

/* Текст features */
.features-text h2 {
  font-family: var(--display);
  font-size: clamp(26px, 3vw, 40px);
  font-weight: 400;
  color: var(--dark);
  line-height: 1.2;
  margin-bottom: 14px;
}
.features-text > p {
  font-size: 16px;
  color: var(--gray-t);
  line-height: 1.75;
  margin-bottom: 36px;
}
.fi-list { display: flex; flex-direction: column; gap: 22px; }
.fi-item { display: flex; gap: 16px; align-items: flex-start; }
.fi-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}
.fi-icon.r { background: rgba(229,57,53,.1); }
.fi-icon.b { background: var(--blue-lt); }
.fi-icon.g { background: rgba(46,125,50,.1); }
.fi-body strong { display: block; font-size: 15px; font-weight: 600; color: var(--dark); margin-bottom: 4px; }
.fi-body p { font-size: 14px; color: var(--gray-t); line-height: 1.55; }

/* ========================
   REVIEWS
======================== */
.reviews { padding: 96px 0; background: var(--dark); }
.reviews .section-h { color: #fff; }
.eyebrow {
  text-align: center;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .14em;
  color: var(--red);
  font-weight: 700;
  margin-bottom: 10px;
}
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 36px;
}
.rev-card {
  border: 1px solid rgba(255,255,255,.08);
  border-radius: var(--r-lg);
  padding: 28px;
  background: rgba(255,255,255,.04);
  transition: background .28s, transform .28s;
}
.rev-card:hover { background: rgba(255,255,255,.08); transform: translateY(-4px); }
.rev-card.featured {
  background: rgba(229,57,53,.09);
  border-color: rgba(229,57,53,.28);
}
.rev-stars { color: #ffc107; font-size: 15px; letter-spacing: 2px; margin-bottom: 14px; }
.rev-text {
  font-size: 15px;
  color: rgba(255,255,255,.8);
  line-height: 1.72;
  font-style: italic;
  margin-bottom: 24px;
}
.rev-author { display: flex; align-items: center; gap: 12px; }
.rev-ava {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.ava1 { background: linear-gradient(135deg,#e53935,#ff7043); }
.ava2 { background: linear-gradient(135deg,#1565c0,#42a5f5); }
.ava3 { background: linear-gradient(135deg,#2e7d32,#66bb6a); }
.rev-author strong { display: block; color: #fff; font-size: 14px; font-weight: 600; }
.rev-author span   { font-size: 12px; color: rgba(255,255,255,.38); }
.dots { display: flex; justify-content: center; gap: 8px; }
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255,255,255,.2);
  cursor: pointer;
  border: none;
  transition: background .2s, transform .2s;
}
.dot.on { background: var(--red); transform: scale(1.35); }

/* ========================
   FOOTER
======================== */
.footer {
  background: var(--dark2);
  color: rgba(255,255,255,.6);
  padding: 64px 0 32px;
  border-top: 1px solid rgba(255,255,255,.05);
}
.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
  padding-bottom: 48px;
  border-bottom: 1px solid rgba(255,255,255,.07);
}
.footer-brand .logo { color: #fff; margin-bottom: 14px; }
.footer-brand p { font-size: 14px; line-height: 1.72; max-width: 270px; margin-bottom: 22px; }
.social-row { display: flex; gap: 8px; }
.soc-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: rgba(255,255,255,.55);
  cursor: pointer;
  text-decoration: none;
  transition: background .2s, color .2s, border-color .2s;
}
.soc-btn:hover { background: var(--red); color: #fff; border-color: var(--red); }
.footer-col h4 {
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  margin-bottom: 18px;
}
.footer-col ul { display: flex; flex-direction: column; gap: 11px; }
.footer-col a { font-size: 14px; color: rgba(255,255,255,.48); transition: color .2s; }
.footer-col a:hover { color: #fff; }
.footer-bot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: rgba(255,255,255,.28);
  flex-wrap: wrap;
  gap: 8px;
}

/* ========================
   SCROLL АНІМАЦІЇ
======================== */
[data-a] { opacity: 0; }
[data-a].in[data-a="up"]    { animation: aUp   .7s ease forwards; }
[data-a].in[data-a="left"]  { animation: aLeft .7s ease forwards; }
[data-a].in[data-a="right"] { animation: aRight .7s ease forwards; }
[data-a].in[data-a="pop"]   { animation: aPop  .6s ease forwards; }

@keyframes aUp    { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:none; } }
@keyframes aLeft  { from { opacity:0; transform:translateX(36px); } to { opacity:1; transform:none; } }
@keyframes aRight { from { opacity:0; transform:translateX(-36px); } to { opacity:1; transform:none; } }
@keyframes aPop   { from { opacity:0; transform:scale(.9); }         to { opacity:1; transform:none; } }

/* ========================
   АДАПТИВНІСТЬ — ПЛАНШЕТ (≤1024px)
======================== */
@media (max-width: 1024px) {
  /* Hero */
  .hero-grid { grid-template-columns: 1fr; gap: 40px; text-align: center; }
  .hero-sub  { max-width: 100%; }
  .hero-btns { justify-content: center; }
  .hero-visual { justify-content: center; flex-wrap: nowrap; }
  .dash-card      { flex: 1 1 0; min-width: 0; }
  .dash-card.dark { flex: 1.3 1 0; margin-top: 20px; }

  /* Stats */
  .stats-grid { grid-template-columns: repeat(2, 1fr); }

  /* Plans */
  .plans-grid { grid-template-columns: repeat(2, 1fr); }
  .plan-card:last-child { grid-column: 1 / -1; max-width: 420px; margin: 0 auto; width: 100%; }

  /* Features */
  .features-grid { grid-template-columns: 1fr; gap: 40px; }
  .feat-card { max-width: 500px; margin: 0 auto; }

  /* Reviews */
  .reviews-grid { grid-template-columns: repeat(2, 1fr); }
  .rev-card:last-child { grid-column: 1 / -1; max-width: 420px; margin: 0 auto; width: 100%; }

  /* Footer */
  .footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
  .footer-brand { grid-column: 1 / -1; }
}

/* ========================
   АДАПТИВНІСТЬ — МОБІЛЬНИЙ (≤640px)
======================== */
@media (max-width: 640px) {
  .wrap { padding: 0 16px; }

  /* Секції */
  .hero   { padding: 48px 0 40px; }
  .stats, .plans, .features, .reviews { padding: 56px 0; }
  .section-h { font-size: 24px; margin-bottom: 28px; }

  /* Navbar */
  .nav-links   { display: none; }
  .nav-actions { display: none; }
  .burger      { display: flex; }

