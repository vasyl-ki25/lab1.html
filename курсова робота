<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Petal — Get your help from our product</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --red:      #e53935;
  --red-dark: #c62828;
  --dark:     #111111;
  --dark2:    #1c1c1e;
  --gray-bg:  #f6f6f4;
  --gray-bd:  #e4e4e4;
  --gray-t:   #888888;
  --blue:     #1565c0;
  --blue-lt:  #e3eeff;
  --green:    #2e7d32;
  --white:    #ffffff;
  --text:     #1a1a1a;
  --font:     'DM Sans', sans-serif;
  --display:  'DM Serif Display', serif;
  --r-sm: 8px;
  --r-md: 16px;
  --r-lg: 24px;
  --r-xl: 32px;
  --sh-sm: 0 2px 8px rgba(0,0,0,.06);
  --sh-md: 0 8px 32px rgba(0,0,0,.10);
  --sh-lg: 0 24px 64px rgba(0,0,0,.13);
  --sh-red: 0 8px 28px rgba(229,57,53,.30);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: var(--font); color: var(--text); background: var(--white); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
a { text-decoration: none; color: inherit; }
ul { list-style: none; }

.wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; }

/* КНОПКИ */
.btn-red {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--red); color: #fff;
  font-family: var(--font); font-size: 14px; font-weight: 600;
  padding: 10px 22px; border-radius: 50px; border: none; cursor: pointer;
  transition: background .22s, transform .18s, box-shadow .22s;
}
.btn-red:hover { background: var(--red-dark); transform: translateY(-2px); box-shadow: var(--sh-red); }
.btn-red.hero-cta { padding: 13px 32px; font-size: 15px; }

.btn-ghost {
  display: inline-flex; align-items: center;
  font-size: 14px; font-weight: 500; color: var(--gray-t);
  padding: 9px 16px; border-radius: 50px; border: none;
  background: transparent; cursor: pointer;
  transition: background .2s, color .2s;
}
.btn-ghost:hover { background: var(--gray-bg); color: var(--text); }

/* NAVBAR */
.nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255,255,255,.95);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--gray-bd);
  transition: box-shadow .3s;
  isolation: isolate;
}
.nav.scrolled { box-shadow: var(--sh-md); }
.nav-inner {
  display: flex; align-items: center; height: 60px; gap: 0;
}
.logo {
  display: flex; align-items: center; gap: 7px;
  font-family: var(--display); font-size: 18px; color: var(--dark);
  white-space: nowrap; flex-shrink: 0;
}
.logo-dot { width: 8px; height: 8px; background: var(--red); border-radius: 50%; flex-shrink: 0; }
.nav-center {
  display: flex; align-items: center; gap: 2px;
  margin: 0 auto;
}
.nav-center a {
  font-size: 14px; font-weight: 500; color: var(--text);
  padding: 7px 16px; border-radius: 50px;
  display: flex; align-items: center; gap: 4px;
  transition: color .2s, background .2s;
}
.nav-center a:hover { background: var(--gray-bg); }
.nav-center a .arrow { font-size: 10px; color: var(--gray-t); }
.nav-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.burger {
  display: none; flex-direction: column; justify-content: center;
  gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; margin-left: auto;
}
.burger span { display: block; width: 22px; height: 2px; background: var(--dark); border-radius: 2px; transition: transform .28s, opacity .2s; }

/* HERO */
.hero {
  padding: 60px 0 50px;
  text-align: center;
  position: relative; overflow: hidden;
}
.hero-eyebrow {
  font-size: 12px; color: var(--gray-t); margin-bottom: 14px; letter-spacing: .02em;
}
.hero h1 {
  font-family: var(--display);
  font-size: clamp(36px, 6vw, 68px);
  font-weight: 400; line-height: 1.08;
  color: var(--dark); margin-bottom: 14px;
}
.hero h1 .hl { color: var(--red); font-style: italic; }
.hero-sub {
  font-size: 15px; color: var(--gray-t); line-height: 1.6;
  max-width: 420px; margin: 0 auto 30px;
}
.hero-btns { display: flex; justify-content: center; gap: 12px; margin-bottom: 48px; }

/* Dashboard блок */
.hero-dashboard {
  background: #fff;
  border: 1px solid var(--gray-bd);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-lg);
  max-width: 820px;
  margin: 0 auto;
  overflow: hidden;
}
/* Верхні метрики */
.db-top {
  display: grid; grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--gray-bd);
  padding: 24px 28px;
  gap: 0;
}
.db-metric { text-align: left; }
.db-metric + .db-metric { border-left: 1px solid var(--gray-bd); padding-left: 28px; }
.db-metric-label { font-size: 11px; color: var(--gray-t); font-weight: 500; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .06em; }
.db-metric-val {
  font-family: var(--display); font-size: clamp(20px, 3vw, 28px); color: var(--dark); line-height: 1;
}
.db-metric-val.plus { color: #2e7d32; }
.db-metric-val.minus { color: var(--red); }

/* Графіки */
.db-charts {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 0;
}
.db-chart-panel {
  padding: 20px 24px;
  border-right: 1px solid var(--gray-bd);
}
.db-chart-panel:last-child { border-right: none; }
.db-chart-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 4px;
}
.db-chart-title { font-size: 13px; font-weight: 600; color: var(--dark); margin-bottom: 2px; }
.db-chart-val { font-family: var(--display); font-size: 20px; color: var(--dark); margin-bottom: 4px; }
.db-chart-sub { font-size: 11px; color: var(--gray-t); margin-bottom: 12px; }
.db-ctrl {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; color: var(--gray-t);
}
.db-ctrl-pill {
  background: var(--gray-bg); border: 1px solid var(--gray-bd); border-radius: 50px;
  padding: 3px 10px; font-size: 11px; color: var(--gray-t); display: flex; align-items: center; gap: 4px;
}
.db-legend { display: flex; gap: 12px; margin-bottom: 10px; }
.db-legend span { font-size: 10px; color: var(--gray-t); display: flex; align-items: center; gap: 4px; }
.db-legend-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

/* STATS — 3 іконки */
.about { padding: 80px 0; background: var(--white); }
.about-eyebrow { text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--gray-t); font-weight: 600; margin-bottom: 12px; }
.section-h {
  font-family: var(--display); font-size: clamp(26px, 3.5vw, 40px);
  font-weight: 400; color: var(--dark); text-align: center;
  margin-bottom: 56px; line-height: 1.2;
}
.about-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.about-item { text-align: center; }
.about-icon { font-size: 32px; margin-bottom: 10px; color: var(--gray-t); }
.about-icon.mono { font-family: 'Courier New', monospace; font-size: 24px; }
.about-item h3 { font-size: 15px; font-weight: 700; color: var(--dark); margin-bottom: 8px; }
.about-item p { font-size: 13px; color: var(--gray-t); line-height: 1.6; max-width: 230px; margin: 0 auto; }

/* PLANS */
.plans { padding: 80px 0; background: var(--gray-bg); }
.plans-eyebrow { text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--gray-t); font-weight: 600; margin-bottom: 10px; }
.plans-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

.plan-card {
  background: var(--white); border: 1px solid var(--gray-bd);
  border-radius: var(--r-md); padding: 24px;
  transition: transform .28s, box-shadow .28s;
}
.plan-card:hover { transform: translateY(-4px); box-shadow: var(--sh-md); }
.plan-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.plan-card-icon {
  width: 44px; height: 30px; background: linear-gradient(135deg, #1a237e, #283593);
  border-radius: 6px; display: flex; align-items: center; justify-content: center;
  font-size: 10px; color: rgba(255,255,255,.6); font-family: 'Courier New', monospace;
  position: relative; overflow: hidden;
}
.plan-card-icon::after {
  content: ''; position: absolute; right: 6px; bottom: 4px;
  width: 12px; height: 8px; background: rgba(255,215,0,.7); border-radius: 2px;
}
.plan-title { font-size: 16px; font-weight: 700; color: var(--dark); margin-bottom: 4px; }
.plan-sub { font-size: 12px; color: var(--gray-t); margin-bottom: 16px; }
.plan-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
.plan-list li { display: flex; justify-content: space-between; align-items: center; font-size: 12px; }
.plan-list .pl-label { color: var(--gray-t); }
.plan-list .pl-val { color: var(--dark); font-weight: 600; font-size: 12px; }
.plan-list .pl-val.none { color: var(--gray-t); font-weight: 400; }
.pl-divider { height: 1px; background: var(--gray-bd); margin: 4px 0; }
.plan-btn-outline {
  display: block; text-align: center; width: 100%;
  padding: 10px 0; border-radius: 50px;
  font-family: var(--font); font-size: 13px; font-weight: 600;
  color: var(--dark); border: 1.5px solid var(--gray-bd);
  background: transparent; cursor: pointer;
  transition: border-color .2s, background .2s, transform .18s;
}
.plan-btn-outline:hover { border-color: var(--red); color: var(--red); transform: translateY(-1px); }

/* FEATURES */
.features { padding: 80px 0; background: var(--white); }
.features-eyebrow { text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--gray-t); font-weight: 600; margin-bottom: 12px; }
.features-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
.feat-item {
  padding: 28px;
  border: 1px solid var(--gray-bd);
  border-radius: var(--r-md);
  background: var(--white);
  transition: transform .28s, box-shadow .28s;
}
.feat-item:hover { transform: translateY(-4px); box-shadow: var(--sh-md); }
.feat-icon-wrap {
  width: 48px; height: 48px; border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; margin-bottom: 16px;
}
.feat-icon-wrap.r { background: rgba(229,57,53,.1); }
.feat-icon-wrap.b { background: var(--blue-lt); }
.feat-icon-wrap.g { background: rgba(46,125,50,.1); }
.feat-item h3 { font-size: 15px; font-weight: 700; color: var(--dark); margin-bottom: 8px; }
.feat-item p { font-size: 13px; color: var(--gray-t); line-height: 1.6; }

/* REVIEWS */
.reviews { padding: 80px 0; background: var(--white); }
.reviews-eyebrow { text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--gray-t); font-weight: 600; margin-bottom: 10px; }
.reviews-wrap { position: relative; }
.reviews-row {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 14px; margin-bottom: 32px;
}
.rev-card {
  border: 1px solid var(--gray-bd); border-radius: var(--r-md);
  padding: 22px; background: var(--white);
  transition: box-shadow .28s, transform .28s;
}
.rev-card:hover { box-shadow: var(--sh-md); transform: translateY(-3px); }
.rev-stars { color: #ffc107; font-size: 13px; letter-spacing: 2px; margin-bottom: 10px; }
.rev-text {
  font-size: 13px; color: var(--gray-t);
  line-height: 1.65; font-style: italic; margin-bottom: 18px;
}
.rev-author { display: flex; align-items: center; gap: 10px; }
.rev-ava {
  width: 34px; height: 34px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0;
}
.ava1 { background: linear-gradient(135deg,#e53935,#ff7043); }
.ava2 { background: linear-gradient(135deg,#1565c0,#42a5f5); }
.ava3 { background: linear-gradient(135deg,#2e7d32,#66bb6a); }
.ava4 { background: linear-gradient(135deg,#6a1b9a,#ab47bc); }
.rev-author strong { display: block; color: var(--dark); font-size: 13px; font-weight: 600; }
.rev-author span { font-size: 11px; color: var(--gray-t); }

.reviews-nav { display: flex; justify-content: center; gap: 10px; }
.nav-arr {
  width: 38px; height: 38px; border-radius: 50%;
  border: 1.5px solid var(--gray-bd); background: var(--white);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; cursor: pointer; color: var(--dark);
  transition: border-color .2s, background .2s;
}
.nav-arr:hover { border-color: var(--dark); background: var(--gray-bg); }

/* FOOTER */
.footer { background: #f4f4f2; padding: 60px 0 28px; border-top: 1px solid var(--gray-bd); }
.footer-grid {
  display: grid; grid-template-columns: 1.2fr 1fr 1fr 1.4fr;
  gap: 48px; margin-bottom: 40px; padding-bottom: 40px;
  border-bottom: 1px solid var(--gray-bd);
}
.footer-col h4 { font-size: 13px; font-weight: 700; color: var(--dark); margin-bottom: 16px; letter-spacing: .02em; }
.footer-col ul { display: flex; flex-direction: column; gap: 10px; }
.footer-col a { font-size: 13px; color: var(--gray-t); transition: color .2s; }
.footer-col a:hover { color: var(--dark); }
.app-btns { display: flex; flex-direction: column; gap: 10px; }
.app-btn {
  display: flex; align-items: center; gap: 10px;
  border: 1.5px solid var(--gray-bd); border-radius: var(--r-sm);
  padding: 9px 16px; background: var(--white); cursor: pointer;
  transition: border-color .2s, box-shadow .2s;
}
.app-btn:hover { border-color: #aaa; box-shadow: var(--sh-sm); }
.app-btn-icon { font-size: 20px; }
.app-btn-text { display: flex; flex-direction: column; }
.app-btn-text small { font-size: 9px; color: var(--gray-t); text-transform: uppercase; letter-spacing: .06em; }
.app-btn-text strong { font-size: 13px; font-weight: 700; color: var(--dark); }
.footer-bot {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 12px; color: var(--gray-t); flex-wrap: wrap; gap: 8px;
}
.social-row { display: flex; gap: 8px; }
.soc-btn {
  width: 30px; height: 30px; border-radius: 50%;
  background: var(--white); border: 1px solid var(--gray-bd);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: var(--gray-t); cursor: pointer;
  text-decoration: none;
  transition: background .2s, color .2s, border-color .2s;
}
.soc-btn:hover { background: var(--dark); color: #fff; border-color: var(--dark); }

/* Scroll animations */
[data-a] { opacity: 0; }
[data-a].in[data-a="up"]    { animation: aUp   .7s ease forwards; }
[data-a].in[data-a="pop"]   { animation: aPop  .6s ease forwards; }
@keyframes aUp  { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:none; } }
@keyframes aPop { from { opacity:0; transform:scale(.95); }        to { opacity:1; transform:none; } }

/* TABLET */
@media (max-width: 1024px) {
  .reviews-row { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

/* MOBILE */
@media (max-width: 640px) {
  .wrap { padding: 0 16px; }
  .hero { padding: 40px 0 32px; }
  .about, .plans, .features, .reviews { padding: 52px 0; }
  .section-h { font-size: 24px; margin-bottom: 28px; }
  .nav-center { display: none; }
  .nav-actions { display: none; }
  .burger { display: flex; }
  .nav-center.open {
    display: flex; flex-direction: column;
    position: absolute; top: 60px; left: 0; right: 0;
    background: #fff; border-bottom: 1px solid var(--gray-bd);
    box-shadow: 0 8px 24px rgba(0,0,0,.12); padding: 10px 16px 16px;
    gap: 2px; z-index: 999;
  }
  .db-top { grid-template-columns: 1fr; }
  .db-metric + .db-metric { border-left: none; padding-left: 0; border-top: 1px solid var(--gray-bd); padding-top: 16px; margin-top: 16px; }
  .db-charts { grid-template-columns: 1fr; }
  .db-chart-panel { border-right: none; border-top: 1px solid var(--gray-bd); }
  .about-grid { grid-template-columns: 1fr; gap: 28px; }
  .plans-grid { grid-template-columns: 1fr; }
  .features-grid3 { grid-template-columns: 1fr; gap: 14px; }
  .reviews-row { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
}
</style>
</head>
