<script>
/* ========== NAVBAR ========== */
const nav    = document.getElementById('nav');
const burger = document.getElementById('burger');
const links  = document.getElementById('navLinks');

window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 20);
});

burger.addEventListener('click', () => {
  links.classList.toggle('open');
  const open = links.classList.contains('open');
  burger.querySelectorAll('span').forEach((s, i) => {
    if (i === 0) s.style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
    if (i === 1) s.style.opacity   = open ? '0' : '';
    if (i === 2) s.style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
  });
});

/* Закрити меню при кліку поза navbar */
document.addEventListener('click', e => {
  if (!nav.contains(e.target)) {
    links.classList.remove('open');
    burger.querySelectorAll('span').forEach(s => { s.style.transform = ''; s.style.opacity = ''; });
  }
});

links.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => {
    links.classList.remove('open');
    burger.querySelectorAll('span').forEach(s => { s.style.transform = ''; s.style.opacity = ''; });
  });
});

/* ========== SCROLL АНІМАЦІЇ ========== */
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  });
}, { threshold: 0.13 });

document.querySelectorAll('[data-a]').forEach(el => io.observe(el));

/* ========== CHART.JS ГРАФІКИ ========== */
Chart.defaults.font.family = "'DM Sans', sans-serif";

// Міні-лінія (картка 1)
new Chart(document.getElementById('c1'), {
  type: 'line',
  data: {
    labels: ['', '', '', '', '', ''],
    datasets: [{
      data: [2100, 2400, 1900, 2800, 3100, 3700],
      borderColor: '#e53935',
      borderWidth: 2,
      pointRadius: 0,
      tension: 0.42,
      fill: true,
      backgroundColor: 'rgba(229,57,53,.1)'
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { x: { display: false }, y: { display: false } },
    animation: { duration: 1400 }
  }
});

// Головний лінійний (темна картка)
new Chart(document.getElementById('c2'), {
  type: 'line',
  data: {
    labels: ['', '', '', '', '', '', ''],
    datasets: [{
      data: [55, 72, 48, 90, 68, 108, 121],
      borderColor: '#e53935',
      borderWidth: 2.5,
      pointRadius: 3,
      pointBackgroundColor: '#e53935',
      tension: 0.42,
      fill: true,
      backgroundColor: 'rgba(229,57,53,.15)'
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { x: { display: false }, y: { display: false } },
    animation: { duration: 1600 }
  }
});

// Стовпчасті (картка 3)
new Chart(document.getElementById('c3'), {
  type: 'bar',
  data: {
    labels: ['Q1', 'Q2', 'Q3', 'Q4'],
    datasets: [{
      data: [2200, 2700, 3100, 3700],
      backgroundColor: [
        'rgba(229,57,53,.28)',
        'rgba(229,57,53,.48)',
        'rgba(229,57,53,.68)',
        'rgba(229,57,53,1)'
      ],
      borderRadius: 4,
      borderSkipped: false
    }]
  },
  options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: { x: { display: false }, y: { display: false } },
    animation: { duration: 1200 }
  }
});

/* ========== COUNTER АНІМАЦІЯ ========== */
function countUp(el, end, prefix, suffix, dur = 1400) {
  const start = performance.now();
  const update = now => {
    const p = Math.min((now - start) / dur, 1);
    const ease = 1 - Math.pow(1 - p, 3);
    el.textContent = prefix + Math.round(end * ease) + suffix;
    if (p < 1) requestAnimationFrame(update);
  };
  requestAnimationFrame(update);
}

const statsSection = document.querySelector('.stats');
const statsIO = new IntersectionObserver(entries => {
  if (entries[0].isIntersecting) {
    document.querySelectorAll('.stat-num').forEach(el => {
      countUp(el,
        +el.dataset.count,
        el.dataset.prefix || '',
        el.dataset.suffix || ''
      );
    });
    statsIO.disconnect();
  }
}, { threshold: 0.4 });
statsIO.observe(statsSection);

/* ========== DOTS ========== */
document.querySelectorAll('.dot').forEach((dot, i, all) => {
  dot.addEventListener('click', () => {
    all.forEach(d => d.classList.remove('on'));
    dot.classList.add('on');
  });
});

/* ========== TILT НА PLAN-CARDS ========== */
document.querySelectorAll('.plan-card').forEach(card => {
  card.addEventListener('mousemove', e => {
    const r = card.getBoundingClientRect();
    const x = (e.clientX - r.left - r.width  / 2) / (r.width  / 2);
    const y = (e.clientY - r.top  - r.height / 2) / (r.height / 2);
    card.style.transform = `translateY(-6px) rotateX(${-y*3}deg) rotateY(${x*3}deg)`;
    card.style.transition = 'transform .05s';
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = '';
    card.style.transition = 'transform .3s';
  });
});
</script>
